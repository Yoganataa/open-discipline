{
  "name": "open-discipline",
  "version": "0.2.0",
  "private": true,
  "description": "OpenCode V1 engineering-discipline plugin with deterministic guardrails and low-noise agent context.",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "open-discipline-install": "./scripts/install-opencode.mjs"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "eval:validate": "node --experimental-strip-types --test tests/evals.test.ts",
    "smoke:opencode": "node scripts/smoke-opencode.mjs",
    "smoke:report": "node scripts/smoke-report.mjs"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.30",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
